                       <height>16777215</height>
                      </size>
                     </property>
                     <property name="text">
                      <string>O modo de aquisição definirá se o ensaio será uma tomografia (envolvendo rotação da amostra) ou uma radiografia (sem rotação da amostra). Caso o modo de aquisição escolhido seja tomografia, será necessário escolher o modo de conexão mecânica responsável pela rotação da amostra e, além disso, a quantidade de imagens precisará estar dentro das opções disponíveis. Caso o modo de aquisição seja radiografia, não será necessária a conexão mecânica e a quantidade de imagens para o ensaio será livre.
</string>
                     </property>
                     <property name="alignment">
                      <set>Qt::AlignmentFlag::AlignJustify|Qt::AlignmentFlag::AlignVCenter</set>
                     </property>
                     <property name="wordWrap">
                      <bool>true</bool>
